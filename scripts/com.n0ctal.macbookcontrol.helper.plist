<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.n0ctal.macbookcontrol.helper</string>

    <!-- Same binary as the app, launched in daemon mode. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Library/PrivilegedHelperTools/com.n0ctal.macbookcontrol.helper</string>
        <string>--helper-daemon</string>
    </array>

    <!-- On-demand: launchd starts the daemon when the app opens this service. -->
    <key>MachServices</key>
    <dict>
        <key>com.n0ctal.macbookcontrol.helper</key>
        <true/>
    </dict>

    <key>KeepAlive</key>
    <false/>
    <key>ProcessType</key>
    <string>Adaptive</string>
</dict>
</plist>
